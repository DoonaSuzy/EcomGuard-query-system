# ============================================================================
# GO1 聚合系统 docker 部署 —— 环境变量样例
#
# 用法：复制为 **.env** 并填真实值（.env 已在 .gitignore 第 34 行）：
#     Copy-Item .env.docker.example .env
#     docker compose up -d --build
#
# ⚠️ 文件名必须是 `.env`，不能是 `.env.docker`：
#    compose 只对项目目录下的 `.env` 做默认插值。用别的名字就得给每条
#    子命令都加 --env-file，漏一次（`docker compose ps` / `logs` / `down`）
#    立刻报「required variable MYSQL_ROOT_PASSWORD is missing」。
#    这是实测踩出来的坑，不是理论风险。
#
# ⚠️ 为什么不能用 modules/credit/.env：
#    api.py 全程不 load_dotenv，容器里读不到 .env 文件。
#    所有配置必须走 compose 的 environment: 显式注入。
# ============================================================================

# ---------------------------------------------------------------- 必填
# MySQL root 密码。compose 里用了 ${MYSQL_ROOT_PASSWORD:?...}，
# 不设置会直接拒绝启动——宁可启动失败，也不要带着空密码跑。
# 建议用强密码；容器内网使用，但仍不要留空。
MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------- 访问地址
# 默认只绑 127.0.0.1，外网要访问才改成 0.0.0.0（并确认防火墙）。
AGG_BIND=127.0.0.1
AGG_PORT=8000

# ---------------------------------------------------------------- 邮件推送
# QQ 邮箱：设置 → 账号 → 开启 POP3/SMTP → 发短信拿 16 位授权码（不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=
SMTP_PASS=

# 两级巡检收件人（各自独立，多地址用英文逗号分隔）
#   每日巡检 → 业务人员：营业执照状态异常、或巡检服务自身出问题时报给他们
MAIL_TO_BUSINESS=
#   每月巡检 → 主管：每月一次汇总，只有存在需要关注的告警才发
MAIL_TO_MANAGER=
# 发件人地址，留空则用 SMTP_USER
MAIL_FROM=

# ---------------------------------------------------------------- 可选
# 企业微信群机器人 Webhook
CREDIT_WEBHOOK=
