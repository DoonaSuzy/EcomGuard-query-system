# ============================================================================
# GO1 聚合系统 docker 部署 —— 环境变量样例
#
# 用法：复制为 `.env.docker` 并填真实值（.env* 已在 .gitignore 里）：
#     cp .env.docker.example .env.docker
#     docker compose --env-file .env.docker up -d --build
#
# ⚠️ 叫 `.env.docker` 就必须每条 compose 子命令都带 `--env-file .env.docker`：
#    compose 只对项目目录下**名字恰好是 `.env`** 的文件做默认插值。
#    漏一次（`ps` / `logs` / `down`）立刻报
#    「required variable MYSQL_ROOT_PASSWORD is missing」——这是实测踩出来的，
#    不是理论风险。
#
#    想彻底免掉这个 flag，就把它改名成 `.env`：
#        mv .env.docker .env
#    之后所有 `docker compose` 命令都不用再带 `--env-file`。
#    两种方式都验证过；本项目 91 机器上部署用的是 `.env.docker` + 显式 flag。
#
# ⚠️ 为什么不能用 modules/credit/.env：
#    api.py 全程不 load_dotenv，容器里读不到 .env 文件。
#    所有配置必须走 compose 的 environment: 显式注入。
# ============================================================================

# ---------------------------------------------------------------- 必填
# MySQL root 密码。compose 里用了 ${MYSQL_ROOT_PASSWORD:?...}，
# 不设置会直接拒绝启动——宁可启动失败，也不要带着空密码跑。
# 建议用强密码；容器内网使用，但仍不要留空。
MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------- 访问地址
# AGG_BIND 决定「谁能打开面板」：
#   127.0.0.1 = 只有这台服务器自己能访问（安全默认，但同事打不开）
#   0.0.0.0   = 局域网/外网都能访问（要给别人用就必须改这个）
# 改成 0.0.0.0 后访问地址是 http://<服务器IP>:${AGG_PORT}
# 注意：改完要 `docker compose up -d app` 重建容器，端口映射在创建时固定，
#       `docker compose restart` 不会重新绑端口。
AGG_BIND=127.0.0.1
AGG_PORT=8000

# ---------------------------------------------------------------- 邮件推送
# QQ 邮箱：设置 → 账号 → 开启 POP3/SMTP → 发短信拿 16 位授权码（不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=
SMTP_PASS=

# 两级巡检收件人（各自独立，多地址用英文逗号分隔）
#   每日巡检 → 业务人员：营业执照状态异常、或巡检服务自身出问题时报给他们
MAIL_TO_BUSINESS=
#   每月巡检 → 主管：每月一次汇总，只有存在需要关注的告警才发
MAIL_TO_MANAGER=
# 发件人地址，留空则用 SMTP_USER
MAIL_FROM=

# ---------------------------------------------------------------- 可选
# 企业微信群机器人 Webhook
CREDIT_WEBHOOK=
