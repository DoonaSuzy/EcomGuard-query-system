    {
      "method": "GET",
      "path": "/api/check/status",
      "endpoint": "get_check_status"
    },
    {
      "method": "GET",
      "path": "/api/export",
      "endpoint": "export_trademarks"
    },
    {
      "method": "POST",
      "path": "/api/import",
      "endpoint": "import_trademarks"
    },
    {
      "method": "GET",
      "path": "/api/reports",
      "endpoint": "get_reports"
    },
    {
      "method": "GET",
      "path": "/api/reports/{filename}",
      "endpoint": "get_report"
    },
    {
      "method": "GET",
      "path": "/api/schema",
      "endpoint": "get_api_schema"
    },
    {
      "method": "GET",
      "path": "/api/trademarks",
      "endpoint": "get_trademarks"
    },
    {
      "method": "POST",
      "path": "/api/trademarks",
      "endpoint": "add_trademark"
    },
    {
