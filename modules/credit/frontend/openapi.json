{
  "openapi": "3.1.0",
  "info": {
    "title": "营业执照状态巡检 API",
    "description": "批量查询企业登记状态（存续/注销/吊销）并在异常时推送提醒。\n\n**使用流程**：`POST /api/jobs` 提交 → `GET /api/jobs/{id}` 轮询 → `GET /api/jobs/{id}/results` 取明细 → `GET /api/jobs/{id}/csv` 下载。\n\n**注意**：抓取由单 worker 串行执行，50 家约需 9–20 分钟。这是刻意的——目标站有瑞数风控，并发等于自伤。",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "健康检查",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "提交巡检作业",
        "operationId": "create_job_api_jobs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "作业列表",
        "operationId": "list_jobs_api_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobSummary"
                  },
                  "title": "Response List Jobs Api Jobs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "作业状态",
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "jobs"
        ],
        "summary": "取消排队中的作业",
        "operationId": "cancel_job_api_jobs__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/results": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "结果明细（可按判定过滤）",
        "operationId": "get_results_api_jobs__job_id__results_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "verdict",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ok",
                    "alert",
                    "notfound",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "只看某类判定",
              "title": "Verdict"
            },
            "description": "只看某类判定"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultItem"
                  },
                  "title": "Response Get Results Api Jobs  Job Id  Results Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/csv": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "下载 CSV",
        "operationId": "download_csv_api_jobs__job_id__csv_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "巡检结果 CSV（UTF-8 with BOM，Excel 直接双击不乱码）",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "作业不存在"
          },
          "409": {
            "description": "作业未完成，CSV 尚未生成"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules": {
      "get": {
        "tags": [
          "schedules"
        ],
        "summary": "定时巡检列表",
        "operationId": "list_schedules_api_schedules_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScheduleOut"
                  },
                  "type": "array",
                  "title": "Response List Schedules Api Schedules Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "schedules"
        ],
        "summary": "新建定时巡检",
        "operationId": "create_schedule_api_schedules_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules/{schedule_id}": {
      "put": {
        "tags": [
          "schedules"
        ],
        "summary": "修改定时巡检",
        "operationId": "update_schedule_api_schedules__schedule_id__put",
        "parameters": [
          {
            "name": "schedule_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Schedule Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "schedules"
        ],
        "summary": "删除定时巡检",
        "operationId": "delete_schedule_api_schedules__schedule_id__delete",
        "parameters": [
          {
            "name": "schedule_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Schedule Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleDeleteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules/{schedule_id}/toggle": {
      "post": {
        "tags": [
          "schedules"
        ],
        "summary": "启用/停用定时巡检",
        "operationId": "toggle_schedule_api_schedules__schedule_id__toggle_post",
        "parameters": [
          {
            "name": "schedule_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Schedule Id"
            }
          },
          {
            "name": "enabled",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "description": "目标状态",
              "title": "Enabled"
            },
            "description": "目标状态"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules/{schedule_id}/run": {
      "post": {
        "tags": [
          "schedules"
        ],
        "summary": "立刻跑一次（不影响下次时间）",
        "description": "手动触发一条调度。\n\n刻意**不动** ``next_run_at``：这是「临时想现在看一下」的需求，\n不该顺延正常节奏——否则周五点了下「立刻执行」，周一的定时就不跑了。",
        "operationId": "run_schedule_now_api_schedules__schedule_id__run_post",
        "parameters": [
          {
            "name": "schedule_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Schedule Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules/preview": {
      "get": {
        "tags": [
          "schedules"
        ],
        "summary": "预览改配置后的下次触发时间（不落库）",
        "description": "编辑弹窗里「下次：周三 09:30」这样的实时预览。\n\n**刻意不落库**：用户还在填表，写库会产生一堆半成品配置；\n而且没有预览时，用户改完保存才能看到「居然排到下个月了」。",
        "operationId": "preview_schedule_api_schedules_preview_get",
        "parameters": [
          {
            "name": "freq",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "daily",
                "weekly",
                "monthly"
              ],
              "type": "string",
              "title": "Freq"
            }
          },
          {
            "name": "at_time",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "HH:MM",
              "title": "At Time"
            },
            "description": "HH:MM"
          },
          {
            "name": "weekday",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 6,
              "minimum": 0,
              "default": 0,
              "title": "Weekday"
            }
          },
          {
            "name": "day",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 28,
              "minimum": 1,
              "default": 1,
              "title": "Day"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchedulePreview"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "state": {
            "type": "string",
            "const": "cancelled",
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "state"
        ],
        "title": "CancelResponse",
        "description": "取消作业的响应。"
      },
      "CheckRequest": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Names",
            "description": "企业全称列表，最多 200 家"
          },
          "webhook": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook",
            "description": "企业微信/钉钉/飞书 webhook，留空则不发"
          },
          "mail_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mail To",
            "description": "收件人，逗号分隔；留空则不发邮件"
          },
          "always_notify": {
            "type": "boolean",
            "title": "Always Notify",
            "description": "无异常也推送。默认 True：巡检结果本身就是交付物，「全部正常」也是有效信息（研发需要每期看到全量名单）。置 False 则只在有异常/待复核时才发。",
            "default": true
          },
          "min_delay": {
            "type": "number",
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Min Delay",
            "description": "两家之间最小间隔秒数",
            "default": 3.5
          },
          "max_delay": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Max Delay",
            "description": "两家之间最大间隔秒数",
            "default": 6.5
          }
        },
        "type": "object",
        "required": [
          "names"
        ],
        "title": "CheckRequest",
        "description": "提交一次巡检作业。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "db": {
            "type": "boolean",
            "title": "Db"
          },
          "queued": {
            "type": "integer",
            "title": "Queued"
          },
          "time": {
            "type": "string",
            "title": "Time"
          }
        },
        "type": "object",
        "required": [
          "status",
          "db",
          "queued",
          "time"
        ],
        "title": "HealthResponse",
        "description": "健康检查响应。\n\n有显式模型才会出现在 openapi.json 的 schema 里；只写 `-> dict` 时\nFastAPI 只能声明成 `additionalProperties: true`，前端代码生成拿到的是\n`{[key: string]: unknown}`——字段名全靠猜，改字段也不会有类型报错。"
      },
      "JobDetail": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "cancelled"
            ],
            "title": "State"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "finished": {
            "type": "integer",
            "title": "Finished"
          },
          "ok": {
            "type": "integer",
            "title": "Ok",
            "default": 0
          },
          "alert": {
            "type": "integer",
            "title": "Alert",
            "default": 0
          },
          "notfound": {
            "type": "integer",
            "title": "Notfound",
            "default": 0
          },
          "unknown": {
            "type": "integer",
            "title": "Unknown",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "notified": {
            "type": "boolean",
            "title": "Notified",
            "default": false
          },
          "notify_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notify Error",
            "description": "推送失败原因；null 表示推送成功或尚未尝试"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ResultItem"
            },
            "type": "array",
            "title": "Results",
            "default": []
          },
          "request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobRequest"
              },
              {
                "type": "null"
              }
            ],
            "description": "提交时的参数回显；老作业可能为 null"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "state",
          "total",
          "finished",
          "created_at"
        ],
        "title": "JobDetail"
      },
      "JobRequest": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Names",
            "default": []
          },
          "webhook": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook"
          },
          "mail_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mail To"
          },
          "always_notify": {
            "type": "boolean",
            "title": "Always Notify",
            "default": false
          },
          "min_delay": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Delay"
          },
          "max_delay": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Delay"
          },
          "schedule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schedule Id",
            "description": "由哪条定时调度创建；手动提交为 null"
          }
        },
        "type": "object",
        "title": "JobRequest",
        "description": "作业提交时的原始参数回显。\n\n用户提完一轮之后最常见的疑问是「我到底填的哪个邮箱 / 有没有配 webhook」。\n原先这些只在 ``jobs.request``（JSON 列）里躺着，``_to_summary`` 直接丢弃，\n详情页无从显示——于是丢了收件人只能重填一遍。\n\n``notify_error`` 与这里配合才能定位问题：先看填了什么，再看推送为什么失败。"
      },
