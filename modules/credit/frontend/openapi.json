{
  "openapi": "3.1.0",
  "info": {
    "title": "营业执照状态巡检 API",
    "description": "批量查询企业登记状态（存续/注销/吊销）并在异常时推送提醒。\n\n**使用流程**：`POST /api/jobs` 提交 → `GET /api/jobs/{id}` 轮询 → `GET /api/jobs/{id}/results` 取明细 → `GET /api/jobs/{id}/csv` 下载。\n\n**注意**：抓取由单 worker 串行执行，50 家约需 9–20 分钟。这是刻意的——目标站有瑞数风控，并发等于自伤。",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "健康检查",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "post": {
        "summary": "提交巡检作业",
        "operationId": "create_job_api_jobs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "作业列表",
        "operationId": "list_jobs_api_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobSummary"
                  },
                  "title": "Response List Jobs Api Jobs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "summary": "作业状态",
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "取消排队中的作业",
        "operationId": "cancel_job_api_jobs__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/results": {
      "get": {
        "summary": "结果明细（可按判定过滤）",
        "operationId": "get_results_api_jobs__job_id__results_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "verdict",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ok",
                    "alert",
                    "notfound",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "只看某类判定",
              "title": "Verdict"
            },
            "description": "只看某类判定"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultItem"
                  },
                  "title": "Response Get Results Api Jobs  Job Id  Results Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/csv": {
      "get": {
        "summary": "下载 CSV",
        "operationId": "download_csv_api_jobs__job_id__csv_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "巡检结果 CSV（UTF-8 with BOM，Excel 直接双击不乱码）",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "作业不存在"
          },
          "409": {
            "description": "作业未完成，CSV 尚未生成"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "state": {
            "type": "string",
            "const": "cancelled",
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "state"
        ],
        "title": "CancelResponse",
        "description": "取消作业的响应。"
      },
      "CheckRequest": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Names",
            "description": "企业全称列表，最多 200 家"
          },
          "webhook": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook",
            "description": "企业微信/钉钉/飞书 webhook，留空则不发"
          },
          "mail_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mail To",
            "description": "收件人，逗号分隔；留空则不发邮件"
          },
          "always_notify": {
            "type": "boolean",
            "title": "Always Notify",
            "description": "无异常也推送（周报用）",
            "default": false
          },
          "min_delay": {
            "type": "number",
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Min Delay",
            "description": "两家之间最小间隔秒数",
            "default": 3.5
          },
          "max_delay": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Max Delay",
            "description": "两家之间最大间隔秒数",
            "default": 6.5
          }
        },
        "type": "object",
        "required": [
          "names"
        ],
        "title": "CheckRequest",
        "description": "提交一次巡检作业。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "db": {
            "type": "boolean",
            "title": "Db"
          },
          "queued": {
            "type": "integer",
            "title": "Queued"
          },
          "time": {
            "type": "string",
            "title": "Time"
          }
        },
        "type": "object",
        "required": [
          "status",
          "db",
          "queued",
          "time"
        ],
        "title": "HealthResponse",
        "description": "健康检查响应。\n\n有显式模型才会出现在 openapi.json 的 schema 里；只写 `-> dict` 时\nFastAPI 只能声明成 `additionalProperties: true`，前端代码生成拿到的是\n`{[key: string]: unknown}`——字段名全靠猜，改字段也不会有类型报错。"
      },
      "JobDetail": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "cancelled"
            ],
            "title": "State"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "finished": {
            "type": "integer",
            "title": "Finished"
          },
          "ok": {
            "type": "integer",
            "title": "Ok",
            "default": 0
          },
          "alert": {
            "type": "integer",
            "title": "Alert",
            "default": 0
          },
          "notfound": {
            "type": "integer",
            "title": "Notfound",
            "default": 0
          },
          "unknown": {
            "type": "integer",
            "title": "Unknown",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "notified": {
            "type": "boolean",
            "title": "Notified",
            "default": false
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ResultItem"
            },
            "type": "array",
            "title": "Results",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "state",
          "total",
          "finished",
          "created_at"
        ],
        "title": "JobDetail"
      },
      "JobSummary": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "cancelled"
            ],
            "title": "State"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "finished": {
            "type": "integer",
            "title": "Finished"
          },
          "ok": {
            "type": "integer",
            "title": "Ok",
            "default": 0
          },
          "alert": {
            "type": "integer",
            "title": "Alert",
            "default": 0
          },
          "notfound": {
            "type": "integer",
            "title": "Notfound",
            "default": 0
          },
          "unknown": {
            "type": "integer",
            "title": "Unknown",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "notified": {
            "type": "boolean",
            "title": "Notified",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "state",
          "total",
          "finished",
          "created_at"
        ],
        "title": "JobSummary"
      },
      "ResultItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "matched_name": {
            "type": "string",
            "title": "Matched Name",
            "default": ""
          },
          "credit_code": {
            "type": "string",
            "title": "Credit Code",
            "default": ""
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": ""
          },
          "verdict": {
            "type": "string",
            "enum": [
              "ok",
              "alert",
              "notfound",
              "unknown"
            ],
            "title": "Verdict",
            "default": "unknown"
          },
          "entity_type": {
            "type": "string",
            "title": "Entity Type",
            "default": ""
          },
          "data_source": {
            "type": "string",
            "title": "Data Source",
            "default": ""
          },
          "record_count": {
            "type": "integer",
            "title": "Record Count",
            "default": 0
          },
          "detail_url": {
            "type": "string",
            "title": "Detail Url",
            "default": ""
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ResultItem"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}