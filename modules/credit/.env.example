# 推送凭据配置示例
# ===========================================================================
# 用法：复制本文件为 .env，填入真实值。.env 已在 .gitignore 中，不会入库。
#     Copy-Item .env.example .env
#
# 优先级：命令行参数 > 环境变量 > .env
# 已存在的环境变量不会被 .env 覆盖（方便 CI / 计划任务临时顶替）。
#
# 配好后验证（不发真邮件，只看配置是否被读到）：
#     .venv\Scripts\python.exe notify.py samples\expected_actual.csv --always
# ===========================================================================

# ---------------------------------------------------------------- QQ 邮箱（推荐）
# 1. 登录 QQ邮箱 → 设置 → 账号 → 开启「POP3/SMTP服务」
# 2. 按提示发短信，拿到 16 位「授权码」——这才是密码，不是 QQ 登录密码
# 3. 填在下面 SMTP_PASS
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=16位授权码（不是登录密码）

# 收件人（两级巡检，各自独立配置）
# ===========================================================================
# 每日巡检 → 业务人员：营业执照状态异常、或巡检服务自身出问题时报给他们
MAIL_TO_BUSINESS=业务人员@company.com
# 每月巡检 → 主管：每月一次汇总，只有存在需要关注的告警才发
MAIL_TO_MANAGER=主管@company.com
#
# 两组都支持多个地址，用英文逗号分隔（中文逗号/分号/换行也能识别）。
# 只想先配一组也行：另一组会回退到下面的 MAIL_TO。
#
# 旧版单收件人键（向后兼容，可留可删）：
# MAIL_TO=someone@company.com

# 发件人地址，留空则用 SMTP_USER
MAIL_FROM=

# ---------------------------------------------------------------- 其他邮箱备选
# 163：SMTP_HOST=smtp.163.com      SMTP_PORT=465 SMTP_SSL=1  （同样用授权码）
# 阿里企业邮：SMTP_HOST=smtp.mxhichina.com SMTP_PORT=465 SMTP_SSL=1
# 腾讯企业邮：SMTP_HOST=smtp.exmail.qq.com SMTP_PORT=465 SMTP_SSL=1
# Gmail：SMTP_HOST=smtp.gmail.com   SMTP_PORT=587 SMTP_SSL=0  （需应用专用密码）
# 自建/内网 SMTP：SMTP_PORT=25 SMTP_SSL=0，并给 notify.py 加 --no-tls

# ---------------------------------------------------------------- 群机器人（可选）
# 企业微信：群设置 → 群机器人 → 添加 → 复制 Webhook 地址
# CREDIT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx

# ---------------------------------------------------------------- API 服务（可选）
# CREDIT_DB=data/jobs.db
# CREDIT_OUT=data/results
